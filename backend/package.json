{
  "name": "wasl-backend",
  "version": "0.1.0",
  "private": true,
  "description": "WASL multi-tenant university female transportation automation SaaS - backend foundation",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "set RUN_DB_TESTS=1&& vitest run tests/integration",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:check-constraints": "tsx scripts/check-raw-constraints.ts",
    "simulate:location": "tsx scripts/simulate-driver-location.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.5.0",
    "cors": "^2.8.5",
    "csv-parse": "7.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "read-excel-file": "9.3.12",
    "socket.io": "^4.8.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "prisma": "^6.5.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "qs": "^6.16.0"
  }
}
