# WASL Backend — environment template
# Copy to .env and fill in real values. Never commit real secrets.

# runtime environment: development | test | staging | production
NODE_ENV=development

# HTTP port
PORT=3000

# PostgreSQL connection string (source of truth)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wasl?schema=public

# Authentication secrets (>= 32 characters). JWT_ACCESS_SECRET signs access JWTs;
# JWT_REFRESH_SECRET is reserved for a future JWT-based refresh design.
JWT_ACCESS_SECRET=change-me-access-secret-please-replace
JWT_REFRESH_SECRET=change-me-refresh-secret-please-replace

# Token lifetimes (ms/s/m/h/d)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated CORS allowlist (no wildcard)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Number of trusted reverse-proxy hops for rate limiting (0 = direct connections)
TRUST_PROXY=0

# Daily attendance-intent cutoff time (HH:mm); students cannot change intent after this
ATTENDANCE_CUTOFF=07:00

# Optional: pino log level (fatal|error|warn|info|debug|trace|silent)
LOG_LEVEL=info
