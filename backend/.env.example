# WASL Backend — environment template
# Copy to .env and fill in real values. Never commit real secrets.

# runtime environment: development | test | staging | production
NODE_ENV=development

# HTTP port
PORT=3000

# PostgreSQL connection string (source of truth)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wasl?schema=public

# Authentication secrets (used in a later phase; required to be present)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Comma-separated CORS allowlist (no wildcard)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Optional: pino log level (fatal|error|warn|info|debug|trace|silent)
LOG_LEVEL=info
